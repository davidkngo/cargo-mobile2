use qtbridge::{qobject, QApp};

#[derive(Default)]
pub struct Backend {}

#[qobject(Singleton)]
impl Backend {
    #[qslot]
    fn say_hello(&self) {
        println!("Hello from Rust!");
    }
}


fn run() {
    eprintln!("[boot] entering event loop");
    let code = QApp::new()
        .load_qml(include_bytes!("qml/Main.qml"))
        .register::<Backend>()
        .run();
    eprintln!("[boot] event loop exited with code {code}");
}

pub fn main() {
    run();
}


#[cfg(any(target_os = "android", target_os = "ios"))]
#[unsafe(no_mangle)]
pub extern "C" fn start_app() {
    run();
}

#[cfg(target_os = "ios")]
#[unsafe(no_mangle)]
pub unsafe extern "C" fn qtbridge_ios_entry(
    argc: core::ffi::c_int,
    argv: *mut *mut core::ffi::c_char,
) -> core::ffi::c_int {
    unsafe extern "C" {
        fn qt_main_wrapper(
            argc: core::ffi::c_int,
            argv: *mut *mut core::ffi::c_char,
        ) -> core::ffi::c_int;
    }
    unsafe { qt_main_wrapper(argc, argv) }
}
