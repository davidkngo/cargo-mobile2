use qtbridge::{qobject, QApp};

mod config;
mod db;

#[derive(Default)]
pub struct Backend {}

#[qobject(Singleton)]
impl Backend {
    #[qslot]
    fn say_hello(&self) {
        println!("Hello from Rust!");
    }
}


fn run() {
    eprintln!("[boot] entering event loop");

    // Load runtime config (embedded Application.toml + APP_*__* env overrides).
    let cfg = config::load();
    eprintln!("[config] dev server: {}:{}", cfg.dev.host, cfg.dev.port);

    // Open the database once on boot so schema migrations run before the UI does.
    if let Err(e) = db::open() {
        eprintln!("[db] init failed: {e}");
    }

    let code = QApp::new()
        .register::<Backend>()
        .add_import_path("qrc:/qml")
        .load_qml_from_file("qrc:/qml/Main.qml")
        .run();
    eprintln!("[boot] event loop exited with code {code}");
}

pub fn main() {
    run();
}


#[cfg(any(target_os = "android", target_os = "ios"))]
#[unsafe(no_mangle)]
pub extern "C" fn start_app() {
    run();
}

#[cfg(target_os = "ios")]
#[unsafe(no_mangle)]
pub unsafe extern "C" fn qtbridge_ios_entry(
    argc: core::ffi::c_int,
    argv: *mut *mut core::ffi::c_char,
) -> core::ffi::c_int {
    unsafe extern "C" {
        fn qt_main_wrapper(
            argc: core::ffi::c_int,
            argv: *mut *mut core::ffi::c_char,
        ) -> core::ffi::c_int;
    }
    unsafe { qt_main_wrapper(argc, argv) }
}
